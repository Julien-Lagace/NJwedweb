---
import { getUi, resolveLocale, type Locale } from '../i18n';
import brideImage from '../assets/images/bride_frame.png';
import groomImage from '../assets/images/groom_frame.png';
import skylineImage from '../assets/images/skyline.png';
import flowersImage from '../assets/images/flowers.png';
import cursiveTextImage from '../assets/images/cursive_text.png';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getUi(locale).landing;
---
<section id="landing" class="relative min-h-screen flex flex-col items-center justify-center px-4 py-10 sm:py-12 bg-cream">

  <!-- Faded Calgary and lily artwork frames the landing content. -->
  <div class="landing-edge-art landing-edge-art-skyline" aria-hidden="true">
    <img src={skylineImage.src} alt="" />
  </div>
  <div class="landing-edge-art landing-edge-art-flowers" aria-hidden="true">
    <img src={flowersImage.src} alt="" />
  </div>

  <aside class="landing-side-copy landing-side-copy-left" aria-label="A beautiful adventure together">
    <img src={cursiveTextImage.src} alt="A beautiful adventure together" />
  </aside>
  <aside class="landing-side-copy landing-side-copy-right" aria-label="Same people, a brighter forever">
    <p>Same people<br /><span>A brighter</span><br /><span>forever</span></p>
  </aside>

  <!-- Decorative floral corners -->
  <svg class="floral-corner top-6 left-6 text-gold" viewBox="0 0 80 80" fill="currentColor">
    <path d="M0,0 Q20,12 28,32 Q10,22 0,0Z" />
    <path d="M4,0 Q24,16 34,42 Q14,24 4,0Z" />
    <path d="M14,4 Q32,22 42,48 Q22,30 14,4Z" />
    <circle cx="8" cy="8" r="2.5" />
  </svg>
  <svg class="floral-corner top-6 right-6 text-gold" style="transform: scaleX(-1)" viewBox="0 0 80 80" fill="currentColor">
    <path d="M0,0 Q20,12 28,32 Q10,22 0,0Z" />
    <path d="M4,0 Q24,16 34,42 Q14,24 4,0Z" />
    <path d="M14,4 Q32,22 42,48 Q22,30 14,4Z" />
    <circle cx="8" cy="8" r="2.5" />
  </svg>
  <svg class="floral-corner bottom-6 left-6 text-gold" style="transform: scaleY(-1)" viewBox="0 0 80 80" fill="currentColor">
    <path d="M0,0 Q20,12 28,32 Q10,22 0,0Z" />
    <path d="M4,0 Q24,16 34,42 Q14,24 4,0Z" />
    <path d="M14,4 Q32,22 42,48 Q22,30 14,4Z" />
    <circle cx="8" cy="8" r="2.5" />
  </svg>
  <svg class="floral-corner bottom-6 right-6 text-gold" style="transform: scale(-1)" viewBox="0 0 80 80" fill="currentColor">
    <path d="M0,0 Q20,12 28,32 Q10,22 0,0Z" />
    <path d="M4,0 Q24,16 34,42 Q14,24 4,0Z" />
    <path d="M14,4 Q32,22 42,48 Q22,30 14,4Z" />
    <circle cx="8" cy="8" r="2.5" />
  </svg>

  <!-- Template-style wedding announcement and countdown -->
  <div class="relative z-10 text-center mb-2 sm:mb-3 fade-up">
    <p class="landing-announcement font-body text-xs sm:text-sm text-brown-medium uppercase">
      {t.announcement}
    </p>
    <p class="font-body text-lg sm:text-xl text-brown-medium mt-2 tracking-[0.18em]">
      {t.date}
    </p>

    <div class="ornament-divider !mt-2 !mb-2">
      <div class="ornament-line"></div>
      <svg class="w-3.5 h-3.5 text-gold flex-shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8,0 L10,6 L16,8 L10,10 L8,16 L6,10 L0,8 L6,6Z" />
      </svg>
      <div class="ornament-line"></div>
    </div>

    <!-- Countdown timer -->
    <div class="countdown-frame mt-4 fade-up">
      <div class="countdown-rule"></div>
      <div class="grid grid-cols-4 gap-4 sm:gap-6">
        <div class="text-center">
          <div class="text-3xl sm:text-4xl font-display text-red-wine mb-1" id="countdown-days">0</div>
          <p class="font-body text-xs sm:text-sm text-brown-light tracking-[0.12em] uppercase">{t.days}</p>
        </div>
        <div class="text-center">
          <div class="text-3xl sm:text-4xl font-display text-red-wine mb-1" id="countdown-hours">0</div>
          <p class="font-body text-xs sm:text-sm text-brown-light tracking-[0.12em] uppercase">{t.hours}</p>
        </div>
        <div class="text-center">
          <div class="text-3xl sm:text-4xl font-display text-red-wine mb-1" id="countdown-minutes">0</div>
          <p class="font-body text-xs sm:text-sm text-brown-light tracking-[0.12em] uppercase">{t.minutes}</p>
        </div>
        <div class="text-center">
          <div class="text-3xl sm:text-4xl font-display text-red-wine mb-1" id="countdown-seconds">0</div>
          <p class="font-body text-xs sm:text-sm text-brown-light tracking-[0.12em] uppercase">{t.seconds}</p>
        </div>
      </div>
      <div class="countdown-rule"></div>
    </div>
  </div>

  <!-- Portraits row -->
  <div class="relative z-10 flex flex-col md:flex-row items-center gap-3 md:gap-2 lg:gap-4 w-full max-w-6xl justify-center">
    <!-- Netra's portrait -->
    <div class="portrait-left md:-mr-20 lg:-mr-32" id="portrait-netra">
      <div>
        <div class="relative overflow-hidden" style="aspect-ratio: 1; width: 500px; max-width: 80vw;">
          <img
            src={brideImage.src}
            alt="Netra"
            class="w-full h-full object-contain"
            loading="lazy"
          />
        </div>
      </div>
      <p class="text-center font-display text-2xl sm:text-4xl text-brown-dark mt-1 tracking-wide">Netra</p>
    </div>

    <!-- Julien's portrait -->
    <div class="portrait-right" id="portrait-julien">
      <div>
        <div class="relative overflow-hidden" style="aspect-ratio: 1; width: 500px; max-width: 80vw;">
          <img
            src={groomImage.src}
            alt="Julien"
            class="w-full h-full object-contain"
            loading="lazy"
          />
        </div>
      </div>
      <p class="text-center font-display text-2xl sm:text-4xl text-brown-dark mt-1 tracking-wide">Julien</p>
    </div>
  </div>
</section>

<style>
  .portrait-left {
    opacity: 0;
    transform: translateX(-80px) translateY(40px) skewY(-2deg);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .portrait-left.visible {
    opacity: 1;
    transform: translateX(0) translateY(0) skewY(0deg);
  }

  .portrait-right {
    opacity: 0;
    transform: translateX(80px) translateY(40px) skewY(2deg);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .portrait-right.visible {
    opacity: 1;
    transform: translateX(0) translateY(0) skewY(0deg);
  }

  .landing-announcement {
    letter-spacing: 0.34em;
    font-weight: 600;
  }

  .countdown-frame {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    width: min(100%, 760px);
  }

  .countdown-frame > .grid {
    flex: 1 1 auto;
  }

  .countdown-rule {
    flex: 1 1 0;
    height: 1px;
    min-width: 2rem;
    background: var(--color-brown-light);
    opacity: 0.55;
  }

  .landing-edge-art {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    opacity: 1;
    filter: saturate(0.9) sepia(0.06) contrast(1.15);
  }

  .landing-edge-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .landing-edge-art-skyline {
    left: 0;
    bottom: 0;
    width: min(38vw, 500px);
    height: 32%;
    opacity: 1;
    mask-image: linear-gradient(to right, black 0%, black 78%, transparent 100%), linear-gradient(to top, black 0%, black 30%, transparent 100%);
    mask-composite: intersect;
  }

  .landing-side-copy {
    position: absolute;
    z-index: 5;
    top: 38%;
    color: var(--color-red-wine);
    pointer-events: none;
    text-align: center;
  }

  .landing-side-copy-left {
    left: clamp(1rem, 5vw, 5rem);
    top: 27%;
    width: min(20.15vw, 254px);
    aspect-ratio: 620 / 732;
    transform: rotate(-8deg);
  }

  .landing-side-copy-left img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .landing-side-copy-right {
    right: clamp(1.5rem, 7vw, 7rem);
    color: var(--color-brown-medium);
    font-family: var(--font-editorial);
    font-size: clamp(0.85rem, 1.25vw, 1.2rem);
    font-weight: 600;
    letter-spacing: 0.24em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .landing-side-copy-right::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    margin: 0.8rem auto 0;
    background: var(--color-brown-light);
  }

  .landing-edge-art-flowers {
    right: 0;
    bottom: 0;
    width: min(34vw, 440px);
    height: 42%;
    opacity: 1;
    mask-image: linear-gradient(to left, black 0%, black 74%, transparent 100%), linear-gradient(to top, black 0%, black 30%, transparent 100%);
    mask-composite: intersect;
  }

  @media (max-width: 767px) {
    .landing-announcement {
      letter-spacing: 0.2em;
    }

    .countdown-frame {
      gap: 0.6rem;
    }

    .countdown-rule {
      min-width: 0.75rem;
    }

    .landing-side-copy {
      display: none;
    }

    .landing-edge-art-skyline {
      width: 52vw;
      height: 24%;
      opacity: 1;
    }

    .landing-edge-art-flowers {
      width: 46vw;
      height: 28%;
      opacity: 1;
    }
  }
</style>

<script>
  // Countdown timer to June 4th, 2027
  function updateCountdown() {
    const weddingDate = new Date('2027-06-04T00:00:00').getTime();
    const now = new Date().getTime();
    const distance = weddingDate - now;

    if (distance < 0) {
      document.getElementById('countdown-days')!.textContent = '0';
      document.getElementById('countdown-hours')!.textContent = '0';
      document.getElementById('countdown-minutes')!.textContent = '0';
      document.getElementById('countdown-seconds')!.textContent = '0';
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    document.getElementById('countdown-days')!.textContent = String(days);
    document.getElementById('countdown-hours')!.textContent = String(hours.toString().padStart(2, '0'));
    document.getElementById('countdown-minutes')!.textContent = String(minutes.toString().padStart(2, '0'));
    document.getElementById('countdown-seconds')!.textContent = String(seconds.toString().padStart(2, '0'));
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
