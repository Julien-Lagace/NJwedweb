---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../HeroSection.astro';
import LandingSection from '../LandingSection.astro';
import GuestCodeSection from '../GuestCodeSection.astro';
import NavigationMenu from '../NavigationMenu.astro';
import OurStorySection from '../OurStorySection.astro';
import SiteFooter from '../SiteFooter.astro';
import { getUi, resolveLocale, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale ?? Astro.currentLocale);
const ui = getUi(locale);
---

<Layout title={ui.meta.defaultTitle} description={ui.meta.defaultDescription} locale={locale}>
  <script is:inline>
    try {
      if (sessionStorage.getItem('weddingUnlocked') === 'true') {
        document.documentElement.classList.add('wedding-unlocked');
      }
    } catch (e) {}
  </script>

  <NavigationMenu locale={locale} />

  <HeroSection locale={locale} />

  <main class="relative z-10">
    <div class="h-screen" aria-hidden="true"></div>

    <LandingSection locale={locale} />
    <GuestCodeSection locale={locale} />

    <div id="wedding-content" class="hidden">
      <OurStorySection locale={locale} />
    </div>
  </main>

  <SiteFooter locale={locale} />
</Layout>

<script>
  import { isUnlocked, setUnlocked } from '../../scripts/guest-gate';

  // =============================================
  // CONFIG — Change the guest code here
  // =============================================
  const VALID_GUEST_CODE = 'nj2027';

  // =============================================
  // Hero blur-on-scroll
  // =============================================
  const hero = document.getElementById('hero');
  const mainNav = document.getElementById('main-nav');
  const blurRange = Math.min(window.innerHeight * 0.85, 750);
  let ticking = false;

  function updateHero() {
    if (!hero) return;
    const progress = Math.min(window.scrollY / blurRange, 1);
    const blur = progress * 22;
    const opacity = 1 - progress * 0.85;
    const scale = 1 + progress * 0.06;

    hero.style.filter = `blur(${blur}px)`;
    hero.style.opacity = String(opacity);
    hero.style.transform = `scale(${scale})`;
    hero.style.pointerEvents = blur > 4 ? 'none' : 'auto';

    const heroHeight = window.innerHeight;
    if (window.scrollY > heroHeight * 0.5) {
      mainNav?.classList.add('!opacity-100', '!pointer-events-auto');
    } else {
      mainNav?.classList.remove('!opacity-100', '!pointer-events-auto');
    }

    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateHero);
      ticking = true;
    }
  }, { passive: true });

  // =============================================
  // Portrait fly-in (Intersection Observer)
  // =============================================
  const portraitObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        } else {
          entry.target.classList.remove('visible');
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.portrait-left, .portrait-right').forEach((el) => {
    portraitObserver.observe(el);
  });

  // =============================================
  // Generic fade-up elements
  // =============================================
  const fadeObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          fadeObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -20px 0px' }
  );

  document.querySelectorAll('.fade-up').forEach((el) => fadeObserver.observe(el));

  // =============================================
  // Guest code form logic
  // =============================================
  const form = document.getElementById('guest-code-form') as HTMLFormElement | null;
  const input = document.getElementById('guest-code-input') as HTMLInputElement | null;
  const errorEl = document.getElementById('guest-code-error');
  const formWrap = document.getElementById('guest-code-form-wrap');
  const welcomeEl = document.getElementById('guest-welcome');
  const weddingContent = document.getElementById('wedding-content');

  function revealStorySections(immediate = false) {
    if (!weddingContent) return;
    const sections = weddingContent.querySelectorAll('.content-section');
    if (immediate) {
      sections.forEach((s) => s.classList.add('revealed'));
      return;
    }
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            sectionObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.04 }
    );
    sections.forEach((s) => sectionObserver.observe(s));
  }

  function unlockSite(opts: { scroll?: boolean; animate?: boolean } = {}) {
    const { scroll = true, animate = true } = opts;

    setUnlocked();
    (window as any).__applyNavUnlockState?.();

    if (formWrap) formWrap.style.display = 'none';
    if (welcomeEl) {
      welcomeEl.classList.remove('hidden');
      if (animate) {
        welcomeEl.style.opacity = '0';
        welcomeEl.style.transform = 'translateY(16px)';
        requestAnimationFrame(() => {
          welcomeEl.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
          welcomeEl.style.opacity = '1';
          welcomeEl.style.transform = 'translateY(0)';
        });
      }
    }

    if (weddingContent) {
      weddingContent.classList.remove('hidden');
      if (animate) {
        weddingContent.style.opacity = '0';
        requestAnimationFrame(() => {
          weddingContent.style.transition = 'opacity 0.8s ease 0.15s';
          weddingContent.style.opacity = '1';
        });
      }
      revealStorySections(!animate);
    }

    if (scroll) {
      setTimeout(() => {
        const codeSection = document.getElementById('guest-code-section');
        if (codeSection) codeSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 350);
    }
  }

  // Restore unlocked state on revisit
  if (isUnlocked()) {
    unlockSite({ scroll: false, animate: false });
  }

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const code = input?.value.trim().toLowerCase() ?? '';

      if (code === VALID_GUEST_CODE) {
        unlockSite({ scroll: true, animate: true });
      } else {
        if (errorEl) errorEl.style.opacity = '1';
        form.classList.add('shake');
        setTimeout(() => form.classList.remove('shake'), 450);
        setTimeout(() => { if (errorEl) errorEl.style.opacity = '0'; }, 3500);
      }
    });
  }

  // =============================================
  // Smooth-scroll with nav offset (in-page anchors)
  // =============================================
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const href = (anchor as HTMLAnchorElement).getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();

      const navH = 56;
      const top = target.getBoundingClientRect().top + window.scrollY - navH;
      window.scrollTo({ top, behavior: 'smooth' });
    });
  });

  // =============================================
  // Recalculate blur range on resize
  // =============================================
  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      updateHero();
    }, 150);
  });
</script>
