---
import { Image } from 'astro:assets';
import PageShell from '../PageShell.astro';
import { getPages, resolveLocale, type Locale } from '../../i18n';
import sangeetImg from '../../assets/images/sangeet.jpg';
import haldiImg from '../../assets/images/haldi.jpg';
import weddingImg from '../../assets/images/wedding.jpg';
import receptionImg from '../../assets/images/reception.jpg';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale ?? Astro.currentLocale);
const page = getPages(locale).whatToExpect;

const eventImages = {
  sangeet: sangeetImg,
  haldi: haldiImg,
  wedding: weddingImg,
  reception: receptionImg,
} as const;
---

<PageShell title={page.title} locale={locale}>
  <section class="py-16 sm:py-20 px-4 bg-cream">
    <div class="max-w-2xl mx-auto text-center">
      <p class="font-body text-red-wine text-xs tracking-[0.3em] uppercase mb-3">{page.eyebrow}</p>
      <h1 class="font-display text-3xl sm:text-4xl text-brown-dark mb-6">{page.heading}</h1>
      <div class="ornament-divider mb-8">
        <div class="ornament-line"></div>
        <svg class="w-3.5 h-3.5 text-gold flex-shrink-0" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8,0 L10,6 L16,8 L10,10 L8,16 L6,10 L0,8 L6,6Z" />
        </svg>
        <div class="ornament-line"></div>
      </div>
      <p class="font-body text-brown-medium text-lg leading-relaxed">
        {page.intro}
      </p>
    </div>
  </section>

  {page.events.map((event, i) => {
    const image = eventImages[event.id as keyof typeof eventImages];
    const imageFirst = i % 2 === 0;

    return (
      <section
        id={event.id}
        class:list={['scroll-mt-20 py-16 sm:py-20 px-4', i % 2 === 0 ? 'bg-beige' : 'bg-cream']}
      >
        <div
          class:list={[
            'max-w-5xl mx-auto grid gap-10 lg:gap-14 lg:grid-cols-2 lg:items-center',
            !imageFirst && 'lg:[direction:rtl]',
          ]}
        >
          <div class:list={[!imageFirst && 'lg:[direction:ltr]']}>
            <Image
              src={image}
              alt={event.title}
              widths={[480, 768, 1200]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              class="w-full h-64 sm:h-80 lg:h-[28rem] object-cover"
            />
          </div>

          <div class:list={['text-center lg:text-left', !imageFirst && 'lg:[direction:ltr]']}>
            <p class="font-body text-red-wine text-xs tracking-[0.3em] uppercase mb-3">{event.eyebrow}</p>
            <h2 class="font-display text-3xl sm:text-4xl text-brown-dark mb-6">{event.title}</h2>
            <div class="ornament-divider mb-8 lg:justify-start">
              <div class="ornament-line"></div>
              <svg class="w-3.5 h-3.5 text-gold flex-shrink-0" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8,0 L10,6 L16,8 L10,10 L8,16 L6,10 L0,8 L6,6Z" />
              </svg>
              <div class="ornament-line"></div>
            </div>
            <p class="font-body text-brown-medium text-lg leading-relaxed mb-5">
              {event.summary}
            </p>
            <p class="font-body text-brown-medium text-lg leading-relaxed">
              {event.guest}
            </p>
          </div>
        </div>
      </section>
    );
  })}
</PageShell>
